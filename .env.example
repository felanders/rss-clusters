# --- Database (Postgres, e.g. Neon) ---
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me
# BETTER_AUTH_URL=http://localhost:3000
# Who may create an account (comma-separated). Empty = sign-up disabled. Every account can trigger LLM calls billed to you.
SIGNUP_ALLOWED_EMAILS=you@example.com
# Extra origins allowed to call the auth API (comma-separated), e.g. a custom domain. Vercel URLs are added automatically.
# TRUSTED_ORIGINS=https://news.example.com

# --- OpenRouter ---
# Either an API key, or (on Vercel) the Vercel Connect integration named in OPENROUTER_CONNECTOR_UID.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_CONNECTOR_UID=openrouter.ai/clustered-rss-feeds-openrouter
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/

# --- Embeddings (step 1: run right after retrieval on "headline + summary") ---
# openrouter (default) or local (needs `pnpm add @huggingface/transformers`)
EMBEDDING_PROVIDER=openrouter
# Multilingual model that cleanly separates same-story pairs (≥0.7) from unrelated ones (≤0.6). ~$0.01 per 1M tokens.
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
# LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small

# --- Clustering (step 2: nearest neighbours → step 3: LLM confirms clusters + writes neutral headline/summary) ---
OPENROUTER_CLUSTER_MODEL=google/gemini-3.5-flash-lite
# Model that splits newsletter issues into stories (cheap extraction work)
OPENROUTER_NEWSLETTER_MODEL=google/gemini-2.5-flash-lite
CLUSTER_OUTPUT_LANGUAGE=English
# Cosine similarity needed for two articles to become neighbour candidates (the LLM still has to confirm).
CLUSTER_NEIGHBOR_THRESHOLD=0.6
# CLUSTER_NEIGHBOR_K=8
# CLUSTER_WINDOW_HOURS=96          # how far back new articles look for neighbours
# CLUSTER_MAX_TIME_GAP_HOURS=48    # two articles must be published within this gap
# CLUSTER_MAX_GROUP_SIZE=20        # largest candidate group per LLM request

# --- Scheduled refresh (vercel.json cron, UTC) ---
CRON_SECRET=change-me
# refresh-and-cluster (default) or refresh-only
SCHEDULED_CLUSTERING_MODE=refresh-and-cluster
